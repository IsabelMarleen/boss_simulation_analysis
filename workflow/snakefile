rule map_sam:
    # we map the reads again, but this time only to the identified target species
    # the alignments are sorted, converted to bam, and indexed
    input:
        reads = f"{path}00_reads/{{cond}}_{{time}}.fa",
    output:
        bam = f"{exp}/03_bams/{{cond}}_{{time}}_{otu}.bam",
        bai = f"{exp}/03_bams/{{cond}}_{{time}}_{otu}.bam.bai"
    params:
        ref=ref,
        otu_raw=otus_no_plasmids_rev[otu],
        otu=otu,
        exp=exp
    conda: "envs/simulation.yaml"
    shell:
        "mkdir -p data/{params.exp}_otu && "
        "python workflow/scripts/extract_sequence.py {params.ref} {params.otu_raw} > data/{params.exp}_otu/{params.otu}.fa && "
        "minimap2 -ax map-ont -t {threads} --secondary=no --sam-hit-only -c data/{params.exp}_otu/{params.otu}.fa {input.reads} | "
        "samtools sort -@ {threads} | samtools view -b >{output.bam} && "
        "samtools index -@ {threads} {output.bam}"



rule pileup:
    # create a pileup from the mappings of each otu at each timepoint
    # the python script extracts the mean coverage and proportion of low coverage sites from the pileup
    input:
        bam = f"{exp}/03_bams/{{cond}}_{{time}}_{{otu}}.bam",
        bai = f"{exp}/03_bams/{{cond}}_{{time}}_{{otu}}.bam.bai"
    output:
        pup = f"{exp}/04_pup/{{cond}}_{{time}}_{{otu}}.pup",
        pup_csv = f"{exp}/04_pup/{{cond}}_{{time}}_{{otu}}.csv",
    params:
        genome_size=lambda w: genome_sizes[w.otu]
    conda: "envs/simulation.yaml"
    shell:
        "samtools mpileup -Q 0 {input.bam} > {output.pup} && "
        "python workflow/scripts/process_pileup.py {output.pup} {params.genome_size} > {output.pup_csv}"




rule record_unblocks:
    # count the number of total reads and unblocked reads for each otu at each timepoint
    # since it's a simulation we can just check which reads are mu-sized to identify unblocked reads
    input:
        reads = f"{path}00_reads/{{cond}}_{{time}}.fa",
    output:
        f"{exp}/05_rejected/{{cond}}_{{time}}_{{otu}}.csv"
    params:
        mu = mu
    conda: "envs/simulation.yaml"
    shell:
        "python workflow/scripts/record_unblocks.py {input} {params.mu} > {output}"



rule create_unblock_dataframe:
    # merge the unblock counts into a single csv
    input:
        expand(f"{exp}/05_rejected/{{cond}}_{{time}}_{{otu}}.csv", cond=conditions, time=timepoints, otu=otus_cleaned),
    output:
        f"results/{exp}/unblocks.csv"
    localrule: True
    params:
        exp = exp
    shell:
        "mkdir -p results/{params.exp} &&"
        "cat <(echo cond,time,otu,total,base_total,unb,unb_ratio) {input} > {output}"



rule create_coverage_dataframe:
    # merge the coverage data into a single csv
    input:
        expand(f"{exp}/04_pup/{{cond}}_{{time}}_{{otu}}.csv", cond=conditions, time=timepoints, otu=otus_cleaned),
    output:
        f"results/{exp}/coverage.csv"
    localrule: True
    params:
        exp = exp
    shell:
        "mkdir -p results/{params.exp} &&"
        "cat <(echo cond,time,otu,mean_coverage,low_coverage_prop,evenness) {input} > {output}"


rule analyse_log:
    # extract time stamps from log file
    input:
        log_file=f"{path}{log_time_stamp}_boss.log"
    output:
        analysed_log=f"results/{exp}/{log_time_stamp}_boss_log_processed.csv"
    params:
        otu = otu
    conda: "envs/simulation.yaml"
    shell:
        "python workflow/scripts/analyse_boss_log.py {input.log_file} {output.analysed_log} {params.otu}"


rule visualise_simulation:
    # create a pdf with some visualisations of the simulation
    input:
        coverage=f"results/{exp}/coverage.csv",
        unblocks=f"results/{exp}/unblocks.csv",
        analysed_log=f"results/{exp}/{log_time_stamp}_boss_log_processed.csv"
    output:
        sim=f"results/{exp}/{today}simulation.png",
        sim_seqt=f"results/{exp}/{today}simulation_seqt.png"
    conda: "envs/visualisation.yaml"
    localrule: True
    params:
        exp = exp,
        dump_time = dump_time,
        pores = pores,
        genome_size=genome_sizes[otu]
    shell:
        "mkdir -p results/{params.exp} &&"
        "Rscript workflow/scripts/visualise_simulation.R "
        " --input_cov {input.coverage} " 
        " --input_unb {input.unblocks} "
        " --dump_time {params.dump_time} "
        " --pores {params.pores} "
        " --genome_size {params.genome_size} "
        " --analysed_log {input.analysed_log}"
        " --output {output.sim} "
        " --output_seqt {output.sim_seqt} "




