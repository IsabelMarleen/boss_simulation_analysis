from config.otu_info import otus_clean_names, otus_no_plasmids, genome_sizes
from datetime import datetime


# load config specific to this simulation
configfile: "workflow/config/config.yaml"

exp = config['exp_name']
if config['reads'] == '':
    path = config['path']
else:
    path = config['reads'] + exp + '/'
    
ref = config['ref']
conditions = config['conditions']
mu = config['mu']
dump_time = config['dump_time']
pores = config['pores']
log_time_stamp = config['log_time_stamp']
timepoints = list(range(config['max_timepoint'] + 1))
otus_cleaned = list(set(otus_clean_names.values()))
otus_no_plasmids_rev = {v: k for k, v in otus_no_plasmids.items()}
# otu = 'hschr21'
today = datetime.now().strftime("%Y-%m-%d_")
snakefile_path = '/hps/nobackup/goldman/ipoetzsch/boss_simulation_example/'



rule all:
    input:
        f"results/{exp}/unblocks.csv",
        f"results/{exp}/coverage.csv",
        f"results/{exp}/{today}simulation.png",
        f"results/{exp}/{today}simulation_seqt.png"



rule map_paf:
    # map the reads from the simulation to a reference containing all species
    # this is done to separate the reads by target species
    input: f"{path}00_reads/{{cond}}_{{time}}.fa"
    output: f"results/{exp}/01_paf/{{cond}}_{{time}}.paf"
    params:
        ref = ref,
        exp = exp
    conda: "envs/simulation.yaml"
    shell:
        "minimap2 -x map-ont -t {threads} --secondary=no -c {params.ref} {input} >{output}"




rule separate_target:
    # separates the reads by target species using the mappings
    # this results in files per: condition_time_otu.fq
    input:
        reads = f"{path}00_reads/{{cond}}_{{time}}.fa",
        paf = f"results/{exp}/01_paf/{{cond}}_{{time}}.paf"
    output: expand("results/{exp}/02_sep_target/{{cond}}_{{time}}_{otu}.fq", otu=otus_cleaned, exp=exp)
    params:
        exp=exp
    conda: "envs/simulation.yaml"
    shell:
        "python3 {snakefile_path}workflow/scripts/separate_by_target.py {input.paf} {input.reads} && "
        "mv {wildcards.cond}_{wildcards.time}_*.fq results/{exp}/02_sep_target/"




rule map_sam:
    # we map the reads again, but this time only to the identified target species
    # the alignments are sorted, converted to bam, and indexed
    input:
        reads = f"results/{exp}/02_sep_target/{{cond}}_{{time}}_{{otu}}.fq",
    output:
        bam = f"results/{exp}/03_bams/{{cond}}_{{time}}_{{otu}}.bam",
        bai = f"results/{exp}/03_bams/{{cond}}_{{time}}_{{otu}}.bam.bai"
    params:
        ref=ref,
        otu_raw=lambda w: f"{otus_no_plasmids_rev[w.otu]}",
        exp=exp
    conda: "envs/simulation.yaml"
    shell:
        "mkdir -p data/{params.exp}_otu && "
        "python3 {snakefile_path}workflow/scripts/extract_sequence.py {params.ref} \"{params.otu_raw}\" > data/{params.exp}_otu/{wildcards.otu}.fa && "
        "minimap2 -ax map-ont -t {threads} --secondary=no --sam-hit-only -c data/{params.exp}_otu/{wildcards.otu}.fa {input.reads} | "
        "samtools sort -@ {threads} | samtools view -b >{output.bam} && "
        "samtools index -@ {threads} {output.bam} &&"
        "if [ {wildcards.time} != 0 ]; then [[ -s {output.bam} ]]; fi "


rule pileup:
    # create a pileup from the mappings of each otu at each timepoint
    # the python script extracts the mean coverage and proportion of low coverage sites from the pileup
    input:
        bam = f"results/{exp}/03_bams/{{cond}}_{{time}}_{{otu}}.bam",
        bai = f"results/{exp}/03_bams/{{cond}}_{{time}}_{{otu}}.bam.bai"
    output:
        pup = f"results/{exp}/04_pup/{{cond}}_{{time}}_{{otu}}.pup",
        pup_csv = f"results/{exp}/04_pup/{{cond}}_{{time}}_{{otu}}.csv",
        pup_full = f"results/{exp}/04_pup/{{cond}}_{{time}}_{{otu}}_full.csv"
    params:
        genome_size=lambda w: genome_sizes[w.otu]
    conda: "envs/simulation.yaml"
    shell:
        "samtools mpileup -Q 0 {input.bam} > {output.pup} && "
        "python3 {snakefile_path}workflow/scripts/process_pileup.py {output.pup} {params.genome_size} {output.pup_full} > {output.pup_csv}" 




rule record_unblocks:
    # count the number of total reads and unblocked reads for each otu at each timepoint
    # since it's a simulation we can just check which reads are mu-sized to identify unblocked reads
    input:
        f"results/{exp}/02_sep_target/{{cond}}_{{time}}_{{otu}}.fq"
    output:
        f"results/{exp}/05_rejected/{{cond}}_{{time}}_{{otu}}.csv"
    params:
        mu = mu
    conda: "envs/simulation.yaml"
    shell:
        "python3 {snakefile_path}workflow/scripts/record_unblocks.py {input} {params.mu} > {output}"



rule create_unblock_dataframe:
    # merge the unblock counts into a single csv
    input:
        expand(f"results/{exp}/05_rejected/{{cond}}_{{time}}_{{otu}}.csv", cond=conditions, time=timepoints, otu=otus_cleaned),
    output:
        f"results/{exp}/unblocks.csv"
    localrule: True
    params:
        exp = exp
    shell:
        "mkdir -p results/{params.exp} &&"
        "cat <(echo cond,time,otu,total,base_total,unb,unb_ratio) {input} > {output}"



rule create_coverage_dataframe:
    # merge the coverage data into a single csv
    input:
        expand(f"results/{exp}/04_pup/{{cond}}_{{time}}_{{otu}}.csv", cond=conditions, time=timepoints, otu=otus_cleaned),
    output:
        f"results/{exp}/coverage.csv"
    localrule: True
    params:
        exp = exp
    shell:
        "mkdir -p results/{params.exp} &&"
        "cat <(echo cond,time,otu,mean_coverage,low_coverage_prop,evenness) {input} > {output}"


rule analyse_log:
    # extract time stamps from log file
    input:
        log_file=f"{path}{log_time_stamp}_boss.log"
    output:
        analysed_log=f"results/{exp}/{log_time_stamp}_boss_log_processed.csv"
    conda: "envs/simulation.yaml"
    shell:
        "python3 {snakefile_path}workflow/scripts/analyse_boss_log.py {input.log_file} {output.analysed_log}"


rule visualise_simulation:
    # create a pdf with some visualisations of the simulation
    input:
        coverage=f"results/{exp}/coverage.csv",
        unblocks=f"results/{exp}/unblocks.csv",
        analysed_log=f"results/{exp}/{log_time_stamp}_boss_log_processed.csv"
    output:
        sim=f"results/{exp}/{today}simulation.png",
        sim_seqt=f"results/{exp}/{today}simulation_seqt.png"
    conda: "envs/visualisation.yaml"
    localrule: True
    params:
        exp = exp,
        dump_time = dump_time,
        pores = pores,
        # genome_size=lambda w: genome_sizes[w.otu]
    shell:
        "mkdir -p results/{params.exp} &&"
        "Rscript {snakefile_path}workflow/scripts/visualise_simulation.R "
        " --input_cov {input.coverage} " 
        " --input_unb {input.unblocks} "
        " --dump_time {params.dump_time} "
        " --pores {params.pores} "
        # " --genome_size {params.genome_size} "
        " --analysed_log {input.analysed_log}"
        " --output {output.sim} "
        " --output_seqt {output.sim_seqt} "




